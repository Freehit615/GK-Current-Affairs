# Telegram API credentials (from https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Telethon StringSession for the userbot account (generate once, see README)
SESSION_STRING=your_string_session_here

# Destination channels (integer chat IDs, typically negative for channels)
POST_CHANNEL_ID=-1001234567890
QUIZ_CHANNEL_ID=-1009876543210

# Comma-separated Telegram user IDs allowed to control the bot
ADMINS=111111111,222222222

# Optional: a source pre-loaded at startup in addition to whatever is in the DB
DEFAULT_SOURCE_ID=-1005555555555

# PostgreSQL connection string (asyncpg-compatible)
DATABASE_URL=postgresql://user:password@host:5432/dbname
